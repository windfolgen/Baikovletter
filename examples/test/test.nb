Cell[TextData[{
 "We get a new representation by redefining ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "11"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0a9346dc-d25e-49f1-801a-35c993e4eb97"],
 " as indicated above. However, in the super-sector where x[4] is a \
propagator, we can not integrate it out either."
}], "Text",
