Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", 
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"G", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"p1", ",", "p2", ",", "p3", ",", "p4"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"p1", ",", "p2", ",", "p3", ",", "p4"}], "}"}]}], 
             "]"}], ",", 
            RowBox[{
             FractionBox["1", "2"], " ", 
             RowBox[{"(", 
              RowBox[{"1", "+", 
               RowBox[{"2", " ", "\[Epsilon]"}]}], ")"}]}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"G", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"l1", ",", "p1", ",", 
                RowBox[{"p2", "+", "p3"}], ",", "p3", ",", "p4"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"l1", ",", "p1", ",", 
                RowBox[{"p2", "+", "p3"}], ",", "p3", ",", "p4"}], "}"}]}], 
             "]"}], ",", 
            RowBox[{
             RowBox[{"-", "1"}], "-", "\[Epsilon]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", 
             RowBox[{"G", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"l1", ",", "p1", ",", 
                 RowBox[{"p2", "+", "p3", "+", "p4"}]}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"l1", ",", "p1", ",", 
                 RowBox[{"p2", "+", "p3", "+", "p4"}]}], "}"}]}], "]"}]}], 
            ",", "\[Epsilon]"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"G", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"l1", ",", "l2", ",", "p1", ",", 
                RowBox[{"p2", "+", "p3", "+", "p4"}]}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"l1", ",", "l2", ",", "p1", ",", 
                RowBox[{"p2", "+", "p3", "+", "p4"}]}], "}"}]}], "]"}], ",", 
            RowBox[{
             RowBox[{"-", 
              FractionBox["1", "2"]}], "-", "\[Epsilon]"}]}], "}"}]}], "}"}], 
        ",", 
        FractionBox[
         RowBox[{
          SuperscriptBox["2", 
           RowBox[{
            RowBox[{"-", "1"}], "-", 
            RowBox[{"2", " ", "\[Epsilon]"}]}]], " ", 
          RowBox[{"Gamma", "[", 
           RowBox[{
            RowBox[{"-", "1"}], "-", "\[Epsilon]"}], "]"}], " ", 
          RowBox[{"Gamma", "[", 
           RowBox[{"-", "\[Epsilon]"}], "]"}]}], 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "+", 
            RowBox[{"2", " ", "\[Epsilon]"}]}], ")"}], " ", 
          RowBox[{"Gamma", "[", 
           RowBox[{
            RowBox[{"-", "2"}], " ", 
            RowBox[{"(", 
             RowBox[{"1", "+", "\[Epsilon]"}], ")"}]}], "]"}]}]]}], "}"}], 
      ",", 
      SubscriptBox["x", "4"], ",", 
      RowBox[{"{", 
